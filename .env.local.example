APP_NAME="Perjadin Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

PERJADIN_ADMIN_NAME=Administrator
PERJADIN_ADMIN_EMAIL=admin@perjadin.local
PERJADIN_ADMIN_PASSWORD=perjadin-admin

PERJADIN_STATIONERY_GOVERNMENT="Provinsi Papua Barat"
PERJADIN_STATIONERY_AGENCY="Badan Kepegawaian Daerah"
PERJADIN_STATIONERY_SECRETARIAT="Sekretariat Daerah"
PERJADIN_STATIONERY_ADDRESS="Jl. Brigjend Marinir (Pur) Abraham O. Atururi Kompleks Perkantoran Arfai"
PERJADIN_STATIONERY_CITY=Manokwari
# Opsional: path absolut untuk mengganti logo Papua Barat bawaan.
PERJADIN_STATIONERY_LOGO_PATH=

# Placeholder: {number}, {year}, {type}; kosong memakai format default.
PERJADIN_SPT_NUMBER_FORMAT=
PERJADIN_SPPD_NUMBER_FORMAT=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=perjadin
DB_USERNAME=perjadin
DB_PASSWORD=perjadin

MYSQL_DATABASE=perjadin
MYSQL_USER=perjadin
MYSQL_PASSWORD=perjadin
MYSQL_ROOT_PASSWORD=root

SIKKEPO_BASE_URL=https://sikkepo.dev-ims.net
SIKKEPO_PLATFORM_CLIENT_ID=
SIKKEPO_PLATFORM_CLIENT_SECRET=
SIKKEPO_TIMEOUT_SECONDS=20
SIKKEPO_CONNECT_TIMEOUT_SECONDS=10
SIKKEPO_RETRY_TIMES=2
SIKKEPO_RETRY_SLEEP_MS=300
SIKKEPO_TOKEN_CACHE_KEY=sikkepo.platform.access_token
SIKKEPO_TOKEN_TTL_SECONDS=300
SIKKEPO_TOKEN_REFRESH_MARGIN_SECONDS=30
