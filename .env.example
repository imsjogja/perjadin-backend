APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

COMPOSE_PROJECT_NAME=perjadin-backend
PERJADIN_BACKEND_PORT=8000
IMS_DB_TUNNEL_GATEWAY=172.25.0.1
PERJADIN_DOCKER_SUBNET=172.25.0.0/16

PERJADIN_ADMIN_NAME=Administrator
PERJADIN_ADMIN_EMAIL=admin@perjadin.local
PERJADIN_ADMIN_PASSWORD=password

# Official document letterhead. Optional absolute path to override the bundled Papua Barat logo.
PERJADIN_STATIONERY_GOVERNMENT="Provinsi Papua Barat"
PERJADIN_STATIONERY_AGENCY="Badan Kepegawaian Daerah"
PERJADIN_STATIONERY_SECRETARIAT="Sekretariat Daerah"
PERJADIN_STATIONERY_ADDRESS="Jl. Brigjend Marinir (Pur) Abraham O. Atururi Kompleks Perkantoran Arfai"
PERJADIN_STATIONERY_CITY=Manokwari
PERJADIN_STATIONERY_SECRETARIAT_ADDRESS="Jl. Brigjend Marinir (Pur) Abraham O. Atururi Kompleks Perkantoran Arfai"
PERJADIN_STATIONERY_SECRETARIAT_CITY=Manokwari
PERJADIN_STATIONERY_LOGO_PATH=

SIKKEPO_BASE_URL=https://sikkepo.dev-ims.net
SIKKEPO_PLATFORM_CLIENT_ID=
SIKKEPO_PLATFORM_CLIENT_SECRET=
SIKKEPO_TIMEOUT_SECONDS=20
SIKKEPO_CONNECT_TIMEOUT_SECONDS=10
SIKKEPO_RETRY_TIMES=2
SIKKEPO_RETRY_SLEEP_MS=300
SIKKEPO_TOKEN_CACHE_KEY=sikkepo.platform.access_token
SIKKEPO_TOKEN_TTL_SECONDS=300
SIKKEPO_TOKEN_REFRESH_MARGIN_SECONDS=30

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Read-only source database used only by `perjadin:import-legacy`.
PERJADIN_LEGACY_CONNECTION=legacy
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=perjadin-pabar
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_SOCKET=
LEGACY_MYSQL_ATTR_SSL_CA=
PERJADIN_LEGACY_MAPPING_DELAY_MS=1000

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
